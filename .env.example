# Copy to .env and adjust. Every value here has a working default in
# app/shared/config.py — this file exists to show what is tunable, not to be required.
#
# Nesting uses a double underscore:  DB__HOST  ->  settings.db.host

ENVIRONMENT=local
LOG_LEVEL=INFO

# ---------------------------------------------------------------- PostgreSQL
DB__HOST=localhost
DB__PORT=5432
DB__USER=rag
DB__PASSWORD=rag
DB__NAME=rag

# Query-time HNSW candidate list. Must exceed the k being retrieved meaningfully.
DB__HNSW_EF_SEARCH=100

# -------------------------------------------------------------------- Ollama
# Runs NATIVELY on macOS, not in Compose — containers cannot reach the Metal GPU.
# From inside a container this becomes http://host.docker.internal:11434
OLLAMA__HOST=http://localhost:11434

OLLAMA__EMBEDDING_MODEL=bge-m3
OLLAMA__EMBEDDING_DIMENSION=1024
# Document summarisation during ingestion only — off the critical path.
OLLAMA__SMALL_MODEL=qwen3:4b
# Contextualisation only — the highest-volume call in the system (one per chunk).
# MUST be a non-reasoning model: qwen3:4b spent ~5,000 tokens and ~194s writing a
# single sentence, which is ~32 hours for a 589-chunk corpus.
OLLAMA__CONTEXTUALISER_MODEL=qwen2.5:3b
# Non-reasoning: qwen3:8b took ~79s per call, 553s for one full answer.
OLLAMA__ANSWERING_MODEL=qwen2.5:7b
# Non-reasoning: on qwen3:4b this ONE call was 177s of a 233s answer. Do not set
# this to qwen2.5:3b — it is faster still, but it failed to catch a fabricated
# figure in the draft, which is the entire job.
OLLAMA__VERIFIER_MODEL=qwen2.5:7b
OLLAMA__JUDGE_MODEL=gemma3:12b
# Tokenizer matching ANSWERING_MODEL. Context budgets are counted with it, never
# estimated. Only tokenizer files are fetched, not weights.
OLLAMA__TOKENIZER_REPO=Qwen/Qwen2.5-7B-Instruct
OLLAMA__NUM_CTX=8192
OLLAMA__TEMPERATURE=0.0

# ----------------------------------------------------------------- Ingestion
INGESTION__MAX_TOKENS_PER_CHUNK=768
INGESTION__MIN_CHUNK_CHARS=100
INGESTION__DEFAULT_COLLECTION=default

# ----------------------------------------------------------------- Retrieval
RETRIEVAL__VECTOR_K=20
RETRIEVAL__KEYWORD_K=20
RETRIEVAL__RRF_K=60
RETRIEVAL__KEEP_QUALITY=5
RETRIEVAL__KEEP_FAST=3

# PROVISIONAL — the design's unfitted guess. Run `eval calibrate` to fit a
# real floor against this corpus, on a held-out split.
RETRIEVAL__KEEP_FLOOR=0.3
RETRIEVAL__INSUFFICIENT_LOW=0.3
RETRIEVAL__SUFFICIENT_HIGH=0.7

# -------------------------------------------------------------------- Agents
AGENTS__SUB_QUESTION_CAP=4
AGENTS__RETRY_CAP=2
AGENTS__SEARCH_BUDGET=6

# ------------------------------------------------------------------- Phoenix
PHOENIX__ENDPOINT=http://localhost:6006
PHOENIX__OTLP_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX__SERVING_PROJECT=rag-serving
PHOENIX__INGESTION_PROJECT=rag-ingestion
PHOENIX__PROMPT_TAG=production

# -------------------------------------------------------------------- Celery
CELERY__BROKER_URL=redis://localhost:6379/0
CELERY__INGESTION_CONCURRENCY=1

# ------------------------------------------------- Conversation memory
# ⚠️ The eviction TRIGGER is the token budget, not the turn count. Turn count is a
# proxy that fails: one turn is 50 tokens, the next is 2,000 with a pasted clause.
CONVERSATION__VERBATIM_BUDGET_TOKENS=1200
CONVERSATION__VERBATIM_TURNS=4
CONVERSATION__SUMMARY_MAX_TOKENS=400
